---
interface Props {
    eyebrow: string;
    title: string;
    intro?: string;
    dark?: boolean;
}
const {eyebrow, title, intro, dark = false} = Astro.props;
---
<div class:list={["section-heading", {dark}]}><p class="eyebrow"><span></span>{eyebrow}</p>
    <h2>{title}</h2>{intro && <p class="intro">{intro}</p>}</div>
