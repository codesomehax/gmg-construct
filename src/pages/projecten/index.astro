---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import { getProjects } from '../../lib/contentful';
const projects = await getProjects();
---
<BaseLayout title="Realisaties | G.M.G. Construct GCV" description="Bekijk een selectie van renovatie- en verbouwingsprojecten van G.M.G. Construct."><Header /><main id="inhoud"><section class="listing-hero"><div class="container"><p class="eyebrow"><span></span>Realisaties</p><h1>Projecten met<br/><em>karakter.</em></h1><p>Een selectie van werk dat we met zorg hebben uitgevoerd. Vervang deze voorbeelditems door uw projecten in Contentful.</p></div></section><section class="section projects"><div class="container"><div class="project-grid">{projects.map((project, index) => <a href={`/projecten/${project.slug}`} class:list={["project-card", `tone-${(index % 3) + 1}`]}><div class="project-visual"><span class="structure"></span><p>Projectfoto<br/>toe te voegen</p></div><div class="project-info"><p>{project.type} · {project.location}</p><h2>{project.title}</h2><span>↗</span></div></a>)}</div></div></section></main><Footer /></BaseLayout>
