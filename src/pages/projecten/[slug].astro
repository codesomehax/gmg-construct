---
import BaseLayout from '../../layouts/BaseLayout.astro'; import Header
    from '../../components/Header.astro'; import Footer from '../../components/Footer.astro'; import {
    getProjects,
    getProject
} from '../../lib/contentful';
export async function getStaticPaths() {
    return (await getProjects('nl-BE')).map(project => ({params: {slug: project.slug}}));
}
const project = await getProject(Astro.params.slug!, 'nl-BE'); if (!project) return Astro.redirect('/projecten');
---
<BaseLayout title={`${project.title} | G.M.G. Construct`} description={project.description} locale="nl-BE"
            alternateUrl="/en/projects/">
    <Header locale="nl-BE" alternateUrl="/en/projects/"/>
    <main id="content">
        <section class="project-detail-hero">
            <div class="container"><a class="back-link" href="/projecten">← Alle realisaties</a>
                <p class="eyebrow"><span></span>{project.type}</p>
                <h1>{project.title}</h1>
                <p>{project.description}</p></div>
        </section>
        <section class="container detail-visual">
            <div><span>Projectfoto's<br/>toe te voegen in Contentful</span></div>
        </section>
        <section class="section container details">
            <div><p class="eyebrow"><span></span>Projectinformatie</p>
                <h2>Met zorg uitgevoerd,<br/>van begin tot eind.</h2></div>
            <dl>
                <div>
                    <dt>Type</dt>
                    <dd>{project.type}</dd>
                </div>
                <div>
                    <dt>Locatie</dt>
                    <dd>{project.location}</dd>
                </div>
                <div>
                    <dt>Jaar</dt>
                    <dd>{project.year}</dd>
                </div>
                <div>
                    <dt>Uitgevoerde werken</dt>
                    <dd>{project.services.join(', ')}</dd>
                </div>
            </dl>
        </section>
        <section class="contact-section small-cta">
            <div class="container"><p class="eyebrow light"><span></span>Ook plannen?</p>
                <h2>Vertel ons waar u<br/><em>naartoe wilt.</em></h2><a href="/#contact" class="button button-yellow">Neem
                    contact op <span>↗</span></a></div>
        </section>
    </main>
    <Footer locale="nl-BE"/>
</BaseLayout>
