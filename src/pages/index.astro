---
import BaseLayout from '../layouts/BaseLayout.astro'; import Header from '../components/Header.astro'; import Footer
    from '../components/Footer.astro'; import SectionHeading from '../components/SectionHeading.astro'; import {
    getProjects
} from '../lib/contentful';
const projects = (await getProjects()).filter((project) => project.featured).slice(0, 3);
---
<BaseLayout title="G.M.G. Construct GCV | Bouwen met zorg"
            description="G.M.G. Construct is uw betrokken partner voor verbouwingen, renovaties en degelijk maatwerk in de regio Antwerpen.">
    <Header/>
    <main id="content">
        <section class="hero">
            <div class="hero-grid"></div>
            <div class="container hero-content"><p class="eyebrow light"><span></span>G.M.G. CONSTRUCT GCV</p>
                <h1>Degelijk gebouwd.<br/><em>Persoonlijk</em> begeleid.</h1>
                <p class="hero-copy">Voor verbouwingen en renovaties waar helder overleg, vakkennis en een verzorgde
                    afwerking centraal staan.</p>
                <div class="hero-actions"><a href="#contact" class="button button-yellow">Bespreek uw plannen <span
                        aria-hidden="true">↗</span></a><a href="#projects" class="text-link light">Bekijk realisaties
                    <span aria-hidden="true">↓</span></a></div>
            </div>
            <div class="hero-mark" aria-hidden="true"><span>G</span><span>M</span><span>G</span></div>
            <p class="hero-caption">Klein genoeg voor persoonlijk contact.<br/>Ervaren genoeg voor een doordachte
                uitvoering.</p></section>
        <section id="services" class="section services container">
            <SectionHeading eyebrow="Wat we doen" title="Van eerste idee tot een stevig eindresultaat."
                            intro="We denken mee over de juiste aanpak en houden de lijnen kort tijdens de uitvoering."/>
            <div class="service-list">
                <article><span>01</span>
                    <h3>Verbouwingen</h3>
                    <p>Uw woning aanpassen aan hoe u vandaag wilt wonen, met respect voor wat er al staat.</p><a
                            href="#contact">Ontdek meer <b>↗</b></a></article>
                <article><span>02</span>
                    <h3>Renovaties</h3>
                    <p>Een grondige opfrissing of totaalrenovatie, zorgvuldig gepland en degelijk uitgevoerd.</p><a
                            href="#contact">Ontdek meer <b>↗</b></a></article>
                <article><span>03</span>
                    <h3>Aanbouwen</h3>
                    <p>Meer plaats, meer licht en een uitbreiding die vanzelfsprekend bij uw huis hoort.</p><a
                            href="#contact">Ontdek meer <b>↗</b></a></article>
            </div>
        </section>
        <section id="projects" class="section projects">
            <div class="container">
                <div class="projects-top">
                    <SectionHeading eyebrow="Recente realisaties" title="Werk waar we graag achter staan."
                                    intro="Hier ziet u een selectie van projecten. Voeg uw eigen realisaties eenvoudig toe via het CMS."/>
                    <a class="text-link" href="/projecten">Alle projecten <span aria-hidden="true">↗</span></a></div>
                <div class="project-grid">{projects.map((project, index) => <a href={`/projecten/${project.slug}`}
                                                                               class:list={["project-card", `tone-${index + 1}`]}>
                    <div class="project-visual"><span class="structure" aria-hidden="true"></span>
                        <p>Projectfoto<br/>toe te voegen</p></div>
                    <div class="project-info"><p>{project.type} · {project.location}</p>
                        <h3>{project.title}</h3><span aria-hidden="true">↗</span></div>
                </a>)}</div>
            </div>
        </section>
        <section id="about" class="section about">
            <div class="container about-grid">
                <div class="about-art">
                    <div class="line-art" aria-hidden="true"></div>
                    <p>Een kleine ploeg.<br/>Eén duidelijke standaard.</p></div>
                <div>
                    <SectionHeading eyebrow="Over G.M.G." title="U spreekt met de mensen die het werk maken."
                                    intro="G.M.G. Construct is een kleinschalig bouwbedrijf. Dat betekent: rechtstreeks contact, korte beslissingen en een ploeg die zich verantwoordelijk voelt voor het eindresultaat."/>
                    <a href="#contact" class="button button-outline">Maak kennis <span aria-hidden="true">↗</span></a>
                </div>
            </div>
        </section>
        <section id="process" class="section process">
            <div class="container">
                <SectionHeading eyebrow="Onze werkwijze" title="Duidelijkheid, van bij de start."/>
                <ol>
                    <li><strong>01</strong>
                        <h3>Luisteren</h3>
                        <p>We bespreken uw plannen, verwachtingen en de mogelijkheden op locatie.</p></li>
                    <li><strong>02</strong>
                        <h3>Afstemmen</h3>
                        <p>U krijgt een heldere aanpak als basis voor het verdere traject.</p></li>
                    <li><strong>03</strong>
                        <h3>Uitvoeren</h3>
                        <p>We bouwen zorgvuldig en houden u betrokken bij de belangrijke momenten.</p></li>
                    <li><strong>04</strong>
                        <h3>Opleveren</h3>
                        <p>We ronden pas af wanneer het resultaat klopt tot in het detail.</p></li>
                </ol>
            </div>
        </section>
        <section id="contact" class="contact-section">
            <div class="container contact-grid">
                <div><p class="eyebrow light"><span></span>Uw plannen bespreken?</p>
                    <h2>Een goed project<br/>begint met een<br/><em>goed gesprek.</em></h2>
                    <p>Vertel ons kort wat u voor ogen hebt. We nemen zo snel mogelijk persoonlijk contact met u op.</p>
                </div>
                <form><label for="name">Naam</label><input id="name" name="name" autocomplete="name" required/><label
                        for="email">E-mailadres</label><input id="email" name="email" type="email" autocomplete="email"
                                                              required/><label for="message">Waarmee kunnen we
                    helpen?</label><textarea id="message" name="message" rows="4" required></textarea>
                    <button class="button button-yellow" type="submit">Verstuur uw vraag <span
                            aria-hidden="true">↗</span></button>
                    <p class="form-note">Dit formulier is een ontwerpvoorbeeld. Koppel het aan uw e-maildienst of
                        formulierverwerker vóór publicatie.</p></form>
            </div>
        </section>
    </main>
    <Footer/>
</BaseLayout>
